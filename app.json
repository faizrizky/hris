{
  "expo": {
    "name": "HRIS Mobile",
    "slug": "hris-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "hrismobile",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.falah.hrismobile"
    },
    "android": {
      "package": "com.falah.hrismobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F7FDB"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class ai.onnxruntime.** { *; }\n-keep class com.google.mlkit.** { *; }"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HRIS memakai lokasi untuk memastikan kamu berada di area kerja saat check-in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HRIS memakai kamera depan untuk memastikan kamu hadir saat check-in. Foto tidak disimpan.",
          "recordAudioAndroid": false
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "ce760ee8-916f-4df2-9369-6ac8dca689c4"
      }
    },
    "owner": "faizrizky",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
