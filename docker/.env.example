# ---------------------------------------------------------------------------
# Konfigurasi stack ERPNext + Frappe HR untuk PENGEMBANGAN LOKAL.
# Salin berkas ini menjadi .env lalu sesuaikan kalau perlu:
#     cp .env.example .env
# Semua nilai di bawah juga sudah jadi default di docker-compose.yml,
# jadi stack tetap jalan walau .env belum dibuat.
# ---------------------------------------------------------------------------

# Prefiks nama container dan volume. Ganti kalau kamu menjalankan lebih dari
# satu instance ERPNext di Mac yang sama.
COMPOSE_PROJECT_NAME=hris-erpnext

# Image hasil build lokal (dibuat oleh ./build-image.sh).
# PULL_POLICY=never penting: image ini tidak ada di Docker Hub, jadi Docker
# tidak boleh mencoba menariknya dari internet.
CUSTOM_IMAGE=hris-erpnext
CUSTOM_TAG=16
PULL_POLICY=never

# Branch Frappe Framework yang dipakai saat build image.
# Harus sejalan dengan branch erpnext dan hrms di apps.json.
FRAPPE_BRANCH=version-16

# Nama site. Akhiran .localhost dipakai supaya enak dibuka dari browser Mac.
# Nilai ini juga dipasang sebagai FRAPPE_SITE_NAME_HEADER di nginx, sehingga
# site tetap terlayani walau diakses lewat IP LAN dari HP.
SITE_NAME=hris.localhost

# Kredensial DEV. Jangan pakai pola seperti ini di server mana pun.
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=admin

# Port di Mac yang dipetakan ke nginx di dalam container.
# Ganti kalau 8080 sudah dipakai aplikasi lain.
HTTP_PUBLISH_PORT=8080
